@model List<GIUA_KY_WEB_3AE.Models.Notification>

@{
    ViewData["Title"] = "Hộp thư thông báo";
    var unreadCount = Model?.Count(n => !n.IsRead) ?? 0;
}

<div class="container my-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">
                <i class="bi bi-bell-fill text-primary me-2"></i>Hộp thư thông báo
            </h1>
            <p class="text-secondary mb-0">Theo dõi các cập nhật mới nhất về trạng thái đơn hàng của bạn.</p>
        </div>
        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllAsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                    <i class="bi bi-check2-all me-1"></i> Đánh dấu tất cả đã đọc
                </button>
            </form>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="notification-empty text-center bg-white border rounded-4 shadow-sm">
            <i class="bi bi-inbox text-primary"></i>
            <h3 class="fw-bold text-dark mt-3 mb-2">Chưa có thông báo</h3>
            <p class="text-secondary mb-4">Khi đơn hàng được tạo hoặc đổi trạng thái, thông báo sẽ xuất hiện tại đây.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold text-white">
                <i class="bi bi-grid-fill me-1"></i> Xem thực đơn
            </a>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var notification in Model)
            {
                <a asp-action="Open" asp-route-id="@notification.Id"
                   class="notification-item @(notification.IsRead ? "is-read" : "is-unread")">
                    <span class="notification-icon">
                        <i class="bi @(GetNotificationIcon(notification.OrderStatus))"></i>
                    </span>
                    <span class="notification-content">
                        <span class="notification-title-row">
                            <strong>@notification.Title</strong>
                            @if (!notification.IsRead)
                            {
                                <span class="badge bg-danger rounded-pill">Mới</span>
                            }
                        </span>
                        <span class="notification-message">@notification.Message</span>
                        <span class="notification-meta">
                            <i class="bi bi-clock me-1"></i>@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            @if (notification.OrderId.HasValue)
                            {
                                <span class="mx-2">·</span>
                                <i class="bi bi-receipt me-1"></i><span>Đơn #@notification.OrderId</span>
                            }
                        </span>
                    </span>
                    <span class="notification-arrow">
                        <i class="bi bi-chevron-right"></i>
                    </span>
                </a>
            }
        </div>
    }
</div>

@functions {
    private static string GetNotificationIcon(string? status)
    {
        return status switch
        {
            "Pending" => "bi-hourglass-split",
            "PendingPayment" => "bi-credit-card",
            "Confirmed" => "bi-check-circle-fill",
            "Shipped" => "bi-truck",
            "Completed" => "bi-patch-check-fill",
            "Cancelled" => "bi-x-circle-fill",
            _ => "bi-bell-fill"
        };
    }
}

@section Scripts {
    <style>
        .notification-empty {
            padding: clamp(48px, 8vw, 84px) 24px;
        }

        .notification-empty i {
            font-size: 4rem;
        }

        .notification-list {
            display: grid;
            gap: 0.85rem;
        }

        .notification-item {
            display: grid;
            grid-template-columns: 48px minmax(0, 1fr) 24px;
            align-items: center;
            gap: 1rem;
            padding: 1.1rem;
            background: #fff;
            border: 1px solid rgba(62, 39, 35, 0.08);
            border-radius: 8px;
            color: inherit;
            text-decoration: none;
            box-shadow: 0 10px 24px rgba(62, 39, 35, 0.05);
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        }

        .notification-item:hover {
            transform: translateY(-2px);
            border-color: rgba(210, 105, 30, 0.35);
            box-shadow: 0 16px 34px rgba(62, 39, 35, 0.09);
            color: inherit;
        }

        .notification-item.is-unread {
            border-left: 4px solid var(--primary-color);
            background: #fffdf9;
        }

        .notification-item.is-read {
            opacity: 0.82;
        }

        .notification-icon {
            width: 48px;
            height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #fff3e7;
            color: var(--primary-color);
            font-size: 1.35rem;
        }

        .notification-content {
            min-width: 0;
            display: grid;
            gap: 0.35rem;
        }

        .notification-title-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            align-items: center;
            color: #2f1c17;
        }

        .notification-message {
            color: #6d554f;
            line-height: 1.5;
        }

        .notification-meta {
            color: #9b8177;
            font-size: 0.88rem;
        }

        .notification-arrow {
            color: #b59990;
        }

        @@media (max-width: 576px) {
            .notification-item {
                grid-template-columns: 42px minmax(0, 1fr);
            }

            .notification-arrow {
                display: none;
            }

            .notification-icon {
                width: 42px;
                height: 42px;
            }
        }
    </style>
}
