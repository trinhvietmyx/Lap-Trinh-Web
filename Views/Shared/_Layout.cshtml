@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using GIUA_KY_WEB_3AE.Data
@using GIUA_KY_WEB_3AE.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@{
    var cartCount = 0;
    var unreadNotificationCount = 0;
    var cartKey = "Mi3AECart_Guest";
    if (User.Identity?.IsAuthenticated == true)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            cartKey = $"Mi3AECart_User_{user.Id}";
            unreadNotificationCount = await DbContext.Notifications.CountAsync(n => n.UserId == user.Id && !n.IsRead);
        }

        // Đã đăng nhập: Tính tổng món ăn từ giỏ hàng User và giỏ hàng Guest (nếu chưa gộp)
        var userCartJson = Context.Session.GetString(cartKey);
        var guestCartJson = Context.Session.GetString("Mi3AECart_Guest");

        var totalItems = new List<GIUA_KY_WEB_3AE.Models.CartItemViewModel>();
        if (!string.IsNullOrEmpty(userCartJson))
        {
            try
            {
                var userItems = JsonSerializer.Deserialize<List<GIUA_KY_WEB_3AE.Models.CartItemViewModel>>(userCartJson);
                if (userItems != null) totalItems.AddRange(userItems);
            }
            catch {}
        }
        if (!string.IsNullOrEmpty(guestCartJson))
        {
            try
            {
                var guestItems = JsonSerializer.Deserialize<List<GIUA_KY_WEB_3AE.Models.CartItemViewModel>>(guestCartJson);
                if (guestItems != null)
                {
                    foreach (var guestItem in guestItems)
                    {
                        var existing = totalItems.FirstOrDefault(i => i.ProductId == guestItem.ProductId);
                        if (existing != null)
                        {
                            existing.Quantity += guestItem.Quantity;
                        }
                        else
                        {
                            totalItems.Add(guestItem);
                        }
                    }
                }
            }
            catch {}
        }
        cartCount = totalItems.Sum(i => i.Quantity);
    }
    else
    {
        // Khách vãng lai: Lấy trực tiếp từ giỏ hàng Guest
        var cartJson = Context.Session.GetString(cartKey);
        if (!string.IsNullOrEmpty(cartJson))
        {
            try
            {
                var cartItems = JsonSerializer.Deserialize<List<GIUA_KY_WEB_3AE.Models.CartItemViewModel>>(cartJson);
                cartCount = cartItems?.Sum(i => i.Quantity) ?? 0;
            }
            catch {}
        }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mì 3AE - Hương Vị Quảng Nam</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Tải Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
