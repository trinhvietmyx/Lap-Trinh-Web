            color: #D2691E !important;
        }
        @@media (min-width: 992px) and (max-width: 1280px) {
            .navbar-custom .nav-link {
                padding-left: 8px !important;
                padding-right: 8px !important;
                font-size: 0.85rem;
            }
            .navbar-custom .btn {
                padding-left: 12px !important;
                padding-right: 12px !important;
                font-size: 0.85rem;
            }
            .navbar-custom .navbar-brand {
                font-size: 1.15rem;
            }
        }
        .footer-custom {
            background-color: #FFF5EB;
            border-top: 1px solid rgba(62, 39, 35, 0.06);
            color: #5d4037;
            font-size: 0.9rem;
        }
        .hover-link {
            transition: all 0.2s ease;
        }
        .hover-link:hover {
            color: #D2691E !important;
            padding-left: 5px;
        }

        /* Premium Notification Dropdown CSS */
        .dropdown-toggle-no-caret::after {
            display: none !important;
        }
        .notification-dropdown-menu {
            border: 1px solid rgba(210, 105, 30, 0.1) !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08) !important;
        }
        .notification-item-dropdown {
            display: flex;
            padding: 12px 16px;
            text-decoration: none;
            color: #3E2723;
            border-bottom: 1px solid rgba(62, 39, 35, 0.05);
            transition: background-color 0.2s ease;
        }
        .notification-item-dropdown:hover {
            background-color: #FFF5EB;
            color: #3E2723;
        }
        .notification-item-dropdown.unread {
            background-color: rgba(210, 105, 30, 0.04);
        }
        .notification-item-dropdown.unread:hover {
            background-color: rgba(210, 105, 30, 0.08);
        }
        .notification-icon-wrapper {
            flex-shrink: 0;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-size: 1.1rem;
        }
        .bg-status-pending { background-color: #FFF3E0; color: #EF6C00; }
        .bg-status-confirmed { background-color: #E8F5E9; color: #2E7D32; }
        .bg-status-shipped { background-color: #E3F2FD; color: #1565C0; }
        .bg-status-completed { background-color: #E8F5E9; color: #2E7D32; }
        .bg-status-cancelled { background-color: #FFEBEE; color: #C62828; }
        .bg-status-default { background-color: #ECEFF1; color: #37474F; }
        
        .notification-text-wrapper {
            flex-grow: 1;
            min-width: 0;
        }
        .notification-title-dropdown {
            font-size: 0.88rem;
            font-weight: 600;
            margin-bottom: 2px;
            display: flex;
            justify-content: space-between;
            align-items: baseline;
        }
        .notification-desc-dropdown {
            font-size: 0.82rem;
            color: #757575;
            line-height: 1.3;
            margin-bottom: 4px;
            word-wrap: break-word;
        }
        .notification-time-dropdown {
            font-size: 0.75rem;
            color: #bdbdbd;
        }
        .unread-dot {
            width: 8px;
            height: 8px;
            background-color: #D2691E;
            border-radius: 50%;
            display: inline-block;
            margin-left: 6px;
            flex-shrink: 0;
        }
    </style>
</head>
<body>
