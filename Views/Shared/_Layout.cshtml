    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Container chứa Toast nổi dùng chung -->
    <div id="toastContainerShared" class="toast-container position-fixed" style="top: 100px; right: 24px; z-index: 1080;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div id="cartToast" class="toast align-items-center text-white bg-success border-0 shadow rounded-4 mb-2" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center py-3 px-3">
                        <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                        <div>
                            <strong class="d-block text-white" style="font-size: 0.95rem;">Thành công</strong>
                            <span class="small opacity-90">@TempData["SuccessMessage"]</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-3 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <!-- Script tự động khởi tạo và hiển thị Toast khi tải trang -->
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var toastEl = document.getElementById('cartToast');
                if (toastEl) {
                    var toast = new bootstrap.Toast(toastEl, {
                        autohide: true,
                        delay: 4000
                    });
                    toast.show();
                }
            });
        </script>
    }

    <!-- ==================== WIDGET CHATBOT AI MÌ 3AE ==================== -->
    <!-- Bong bóng chat nổi -->
    <div id="chatbotBubble" class="position-fixed shadow-lg d-flex align-items-center justify-content-center" style="bottom: 24px; right: 24px; width: 60px; height: 60px; border-radius: 50%; background-color: #D2691E; color: white; z-index: 1050; cursor: pointer; transition: all 0.3s ease;">
        <i class="bi bi-chat-dots-fill fs-3"></i>
    </div>

    <!-- Cửa sổ chat chính -->
    <div id="chatbotWindow" class="position-fixed shadow-lg d-flex flex-column border-0 rounded-4 overflow-hidden bg-white d-none" style="bottom: 96px; right: 24px; width: 360px; height: 500px; z-index: 1050; border: 1px solid rgba(210,105,30,0.15) !important; transition: all 0.3s ease;">
        <!-- Header cửa sổ chat -->
        <div class="d-flex align-items-center justify-content-between px-3 py-3 text-white" style="background-color: #D2691E;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-robot fs-4"></i>
                <div>
                    <h6 class="mb-0 fw-bold" style="font-size: 0.95rem;">Trợ lý ảo Mì 3AE</h6>
                    <small class="opacity-75" style="font-size: 0.75rem;">Đang trực tuyến</small>
                </div>
            </div>
            <button id="chatbotClose" class="btn btn-link text-white p-0 border-0 shadow-none"><i class="bi bi-x-lg"></i></button>
        </div>

        <!-- Vùng chứa tin nhắn -->
        <div id="chatbotMessages" class="flex-grow-1 p-3 overflow-y-auto bg-light bg-opacity-50" style="font-size: 0.88rem; scrollbar-width: thin;">
            <div class="d-flex gap-2 mb-3">
                <div class="rounded-3 p-2 px-3 text-dark shadow-sm" style="background-color: #FFF5EB; max-width: 85%; border: 1px solid rgba(210,105,30,0.08);">
                    Chào bạn! 🍜 Tôi là **Trợ lý ảo Mì 3AE**. Em có thể giúp gì cho bạn hôm nay ạ? Bạn có thể hỏi về thực đơn món ăn hoặc nhập mã đơn hàng dạng `#mã` để em tra cứu trạng thái nhé!
                </div>
            </div>
        </div>

        <!-- Khung hiển thị Typing Indicator (chờ AI phản hồi) -->
        <div id="chatbotTyping" class="px-3 py-1 bg-light bg-opacity-50 d-none" style="font-size: 0.8rem;">
            <div class="d-inline-flex gap-1 align-items-center rounded-3 p-2 px-3 text-secondary shadow-sm" style="background-color: #FFF5EB; border: 1px solid rgba(210,105,30,0.08);">
                <span class="spinner-grow spinner-grow-sm text-secondary" role="status" style="width: 6px; height: 6px;"></span>
                <span class="spinner-grow spinner-grow-sm text-secondary" role="status" style="width: 6px; height: 6px; animation-delay: 0.2s;"></span>
                <span class="spinner-grow spinner-grow-sm text-secondary" role="status" style="width: 6px; height: 6px; animation-delay: 0.4s;"></span>
                <span class="ms-1 small">Mì 3AE đang gõ...</span>
            </div>
        </div>

        <!-- Khung các câu hỏi gợi ý nhanh -->
        <div class="px-3 py-2 bg-white border-top border-light d-flex gap-1 overflow-x-auto flex-nowrap" id="chatbotSuggestions" style="font-size: 0.8rem; scrollbar-width: none; -webkit-overflow-scrolling: touch;">
            <span class="badge bg-light text-secondary border rounded-pill py-1.5 px-2.5 cursor-pointer chatbot-suggest-btn" style="cursor: pointer; border-color: rgba(62,39,35,0.08) !important;">Thực đơn hôm nay?</span>
            <span class="badge bg-light text-secondary border rounded-pill py-1.5 px-2.5 cursor-pointer chatbot-suggest-btn" style="cursor: pointer; border-color: rgba(62,39,35,0.08) !important;">Địa chỉ quán ở đâu?</span>
            <span class="badge bg-light text-secondary border rounded-pill py-1.5 px-2.5 cursor-pointer chatbot-suggest-btn" style="cursor: pointer; border-color: rgba(62,39,35,0.08) !important;">Kiểm tra đơn hàng?</span>
        </div>

        <!-- Footer nhập tin nhắn -->
        <div class="p-2 bg-white border-top d-flex gap-1 align-items-center">
            <input type="text" id="chatbotInput" class="form-control rounded-pill border-light-subtle px-3 py-2" placeholder="Nhập tin nhắn của bạn..." style="font-size: 0.85rem; border: 1px solid rgba(62,39,35,0.12);" />
            <button id="chatbotSend" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center p-0" style="width: 38px; height: 38px; background-color: #D2691E; border: none; color: white;">
                <i class="bi bi-send-fill fs-6"></i>
            </button>
        </div>
    </div>

    <!-- Script điều khiển Chatbot AI -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const bubble = document.getElementById("chatbotBubble");
            const win = document.getElementById("chatbotWindow");
            const closeBtn = document.getElementById("chatbotClose");
            const sendBtn = document.getElementById("chatbotSend");
            const inputEl = document.getElementById("chatbotInput");
            const msgsContainer = document.getElementById("chatbotMessages");
            const typingEl = document.getElementById("chatbotTyping");
            const suggestBtns = document.querySelectorAll(".chatbot-suggest-btn");

            // Hiệu ứng hover nổi bật bong bóng chat
            bubble.addEventListener("mouseover", () => {
                bubble.style.transform = "scale(1.1) rotate(5deg)";
            });
            bubble.addEventListener("mouseout", () => {
                bubble.style.transform = "scale(1) rotate(0deg)";
            });

            // Mở/đóng cửa sổ chat
            bubble.addEventListener("click", () => {
                win.classList.toggle("d-none");
                if (!win.classList.contains("d-none")) {
                    inputEl.focus();
                    scrollToBottom();
                }
            });

            closeBtn.addEventListener("click", () => {
                win.classList.add("d-none");
            });

            // Cuộn xuống tin nhắn mới nhất
            function scrollToBottom() {
                msgsContainer.scrollTop = msgsContainer.scrollHeight;
            }

            // Gửi tin nhắn
            async function handleSendMessage(text) {
                if (!text || text.trim() === "") return;
                
                // Hiển thị tin nhắn người dùng
                appendMessage(text, "user");
                inputEl.value = "";
                scrollToBottom();

                // Hiển thị trạng thái đang trả lời (typing indicator)
                typingEl.classList.remove("d-none");
                scrollToBottom();

                try {
                    const response = await fetch("/api/chat/send", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ Message: text })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        appendMessage(data.reply, "bot");
                    } else {
                        if (response.status === 401) {
                            appendMessage("Dạ, bạn vui lòng đăng nhập tài khoản để trò chuyện cùng Trợ lý ảo Mì 3AE nhé! 🍜", "bot");
                        } else {
                            appendMessage("Rất tiếc, máy chủ phản hồi lỗi. Bạn vui lòng thử lại sau.", "bot");
                        }
                    }
                } catch (error) {
                    appendMessage("Không thể kết nối đến máy chủ. Vui lòng kiểm tra lại kết nối mạng.", "bot");
                } finally {
                    typingEl.classList.add("d-none");
                    scrollToBottom();
                }
            }

            // Thêm bong bóng chat vào container
            function appendMessage(text, sender) {
                const messageWrapper = document.createElement("div");
                messageWrapper.className = `d-flex gap-2 mb-3 ${sender === "user" ? "justify-content-end" : ""}`;
                
                const bubbleEl = document.createElement("div");
                bubbleEl.className = "rounded-3 p-2 px-3 shadow-sm";
                
                if (sender === "user") {
                    bubbleEl.style.backgroundColor = "#D2691E";
                    bubbleEl.style.color = "white";
                    bubbleEl.style.maxWidth = "85%";
                    bubbleEl.textContent = text;
                } else {
                    bubbleEl.style.backgroundColor = "#FFF5EB";
                    bubbleEl.style.color = "#3E2723";
                    bubbleEl.style.maxWidth = "85%";
                    bubbleEl.style.border = "1px solid rgba(210,105,30,0.08)";
                    
                    // Render xuống dòng an toàn bằng DOM (tránh XSS qua innerHTML với nội dung từ API)
                    const lines = text.split("\n");
                    lines.forEach((line, idx) => {
                        const span = document.createElement("span");
                        span.textContent = line;
                        bubbleEl.appendChild(span);
                        if (idx < lines.length - 1) {
                            bubbleEl.appendChild(document.createElement("br"));
                        }
                    });
                }
                
                messageWrapper.appendChild(bubbleEl);
                msgsContainer.appendChild(messageWrapper);
            }

            // Sự kiện Click và Enter
            sendBtn.addEventListener("click", () => handleSendMessage(inputEl.value));
            inputEl.addEventListener("keypress", (e) => {
                if (e.key === "Enter") {
                    handleSendMessage(inputEl.value);
                }
            });

            // Sự kiện click gợi ý nhanh
            suggestBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    const question = btn.textContent;
                    handleSendMessage(question);
                });
            });
        });
    </script>

    <!-- Script điều khiển Hộp thư thông báo Dropdown -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const dropdownToggle = document.getElementById("navbarNotificationDropdown");
            if (!dropdownToggle) return;

            const dropdownList = document.getElementById("notificationDropdownList");
            const loadingIndicator = document.getElementById("notificationLoading");
            const badge = document.getElementById("notificationBadge");
            const markAllReadBtn = document.getElementById("markAllReadBtn");

            // Biểu tượng động theo trạng thái đơn hàng
            function getNotificationIconClass(status) {
                switch (status) {
                    case "Pending": return "bi-hourglass-split";
                    case "Confirmed": return "bi-check-circle-fill";
                    case "Shipped": return "bi-truck";
                    case "Completed": return "bi-box-seam-fill";
                    case "Cancelled": return "bi-x-circle-fill";
                    default: return "bi-bell-fill";
                }
            }

            // Lớp màu nền tương ứng cho icon wrapper
            function getNotificationStatusBg(status) {
                switch (status) {
                    case "Pending": return "bg-status-pending";
                    case "Confirmed": return "bg-status-confirmed";
                    case "Shipped": return "bg-status-shipped";
                    case "Completed": return "bg-status-completed";
                    case "Cancelled": return "bg-status-cancelled";
                    default: return "bg-status-default";
                }
            }

            // Hàm tải danh sách thông báo mới nhất qua AJAX
            async function loadLatestNotifications() {
                loadingIndicator.classList.remove("d-none");
                dropdownList.innerHTML = "";
                
                try {
                    const response = await fetch("/Notifications/GetLatest");
                    if (response.ok) {
                        const notifications = await response.json();
                        loadingIndicator.classList.add("d-none");
                        
                        if (notifications.length === 0) {
                            dropdownList.innerHTML = `
                                <li class="text-center py-4 text-muted small">
                                    <i class="bi bi-bell-slash fs-3 d-block mb-2 text-opacity-50" style="color: #D2691E;"></i>
                                    Bạn chưa có thông báo nào.
                                </li>`;
                            return;
                        }

                        notifications.forEach(n => {
                            const iconClass = getNotificationIconClass(n.orderStatus);
                            const bgClass = getNotificationStatusBg(n.orderStatus);
                            const itemClass = n.isRead ? "" : "unread";
                            const dotHtml = n.isRead ? "" : '<span class="unread-dot"></span>';
                            
                            const li = document.createElement("li");
                            li.innerHTML = `
                                <a href="/Notifications/Open/${n.id}" class="notification-item-dropdown ${itemClass}">
                                    <div class="notification-icon-wrapper ${bgClass}">
                                        <i class="bi ${iconClass}"></i>
                                    </div>
                                    <div class="notification-text-wrapper">
                                        <div class="notification-title-dropdown">
                                            <span class="text-truncate" style="max-width: 180px;">${n.title}</span>
                                            ${dotHtml}
                                        </div>
                                        <div class="notification-desc-dropdown">${n.message}</div>
                                        <div class="notification-time-dropdown d-flex justify-content-between align-items-center">
                                            <span>${n.createdAt}</span>
                                            ${n.orderId ? `<span class="badge bg-secondary text-white px-2 py-0.5 rounded-pill" style="font-size: 0.68rem;">Đơn #${n.orderId}</span>` : ""}
                                        </div>
                                    </div>
                                </a>`;
                            dropdownList.appendChild(li);
                        });
                    } else {
                        dropdownList.innerHTML = '<li class="text-center py-4 text-danger small">Lỗi tải thông báo. Vui lòng thử lại.</li>';
                    }
                } catch (error) {
                    dropdownList.innerHTML = '<li class="text-center py-4 text-danger small">Lỗi kết nối mạng.</li>';
                }
            }

            // Gọi tải dữ liệu khi người dùng bấm mở Dropdown
            const dropdownContainer = document.getElementById("notificationDropdownContainer");
            dropdownContainer.addEventListener("show.bs.dropdown", function () {
                loadLatestNotifications();
            });

            // Xử lý nút Đánh dấu tất cả đã đọc
            markAllReadBtn.addEventListener("click", async function (e) {
                e.preventDefault();
                e.stopPropagation();
                
                try {
                    const response = await fetch("/Notifications/MarkAllAsReadApi", {
                        method: "POST"
                    });
                    
                    if (response.ok) {
                        const data = await response.json();
                        if (data.success) {
                            // Ẩn badge đếm số lượng thông báo chưa đọc
                            if (badge) {
                                badge.classList.add("d-none");
                                badge.textContent = "0";
                            }
                            
                            // Cập nhật lại UI các item đang hiển thị
                            const unreadItems = dropdownList.querySelectorAll(".notification-item-dropdown.unread");
                            unreadItems.forEach(item => {
                                item.classList.remove("unread");
                                const dot = item.querySelector(".unread-dot");
                                if (dot) dot.remove();
                            });
                        }
                    }
                } catch (error) {
                    console.error("Lỗi đánh dấu đã đọc:", error);
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
