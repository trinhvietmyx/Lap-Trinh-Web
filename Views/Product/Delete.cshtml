@model GIUA_KY_WEB_3AE.Models.Product

@{
    ViewData["Title"] = "Xác nhận xóa sản phẩm - " + Model.Name;
    var categoryName = ViewBag.CategoryName as string ?? "Không xác định";
}

<div class="container my-5" style="max-width: 600px;">
    <!-- Nút quay lại -->
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Hộp thoại Xác nhận xóa -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-5">
        <div class="text-center mb-4">
            <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-exclamation-triangle display-5"></i>
            </div>
            <h1 class="h3 fw-bold text-dark mb-1">Xác nhận xóa?</h1>
            <p class="text-muted mb-0">Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa sản phẩm dưới đây?</p>
        </div>

        <!-- Khối thông tin tóm tắt sản phẩm -->
        <div class="bg-light p-3 rounded-3 mb-4 d-flex align-items-center gap-3">
            <div class="rounded-3 overflow-hidden border bg-white" style="width: 70px; height: 70px; flex-shrink: 0;">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100 h-100" style="object-fit: cover;">
            </div>
            <div>
                <span class="badge bg-secondary text-white rounded-pill px-2 py-1 fs-8 mb-1">@categoryName</span>
                <h5 class="fw-bold text-dark mb-0">@Model.Name</h5>
                <small class="text-primary fw-bold">@Model.Price.ToString("#,##0") đ</small>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <!-- Các nút bấm -->
            <div class="d-flex gap-3">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2 flex-fill">Hủy bỏ</a>
                <button type="submit" class="btn btn-danger rounded-pill py-2 flex-fill shadow-sm">
                    <i class="bi bi-trash me-1"></i> Xác nhận xóa
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        .fs-8 {
            font-size: 0.75rem;
        }
    </style>
}
