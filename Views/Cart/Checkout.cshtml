@model GIUA_KY_WEB_3AE.Models.CheckoutViewModel
@using Microsoft.AspNetCore.Identity
@using GIUA_KY_WEB_3AE.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Thanh toán đơn hàng - Mì 3AE";

    // Đọc cấu hình ngân hàng VietQR từ appsettings.json để truyền xuống JS
    var vietqrBankId = Configuration["VietQR:BankId"] ?? "vietinbank";
    var vietqrAccountNo = Configuration["VietQR:AccountNo"] ?? "113366668888";
    var vietqrAccountName = Configuration["VietQR:AccountName"] ?? "QUAN MI QUANG 3AE";
    var vietqrTemplate = Configuration["VietQR:Template"] ?? "compact2";
}

<!-- CSS Tùy biến cho trang Checkout mang phong cách Thế Giới Di Động Premium -->
<style>
    body {
        background-color: #FFF8F0;
    }
    .checkout-container {
        max-width: 960px;
        margin: 100px auto 50px auto !important;
    }
    .card-custom {
        border: none;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 4px 20px rgba(62, 39, 35, 0.04);
        margin-bottom: 20px;
    }
    .top-tab {
        border-radius: 10px;
        background-color: #FFF5EB;
        padding: 4px;
    }
    .top-tab .nav-link {
        border-radius: 8px;
        color: #5d4037;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 8px 16px;
        transition: all 0.2s ease;
        border: none;
        background: none;
        width: 50%;
        text-align: center;
    }
    .top-tab .nav-link.active {
        background-color: #ffffff;
        color: #D2691E;
        box-shadow: 0 2px 8px rgba(210, 105, 30, 0.08);
    }
    .address-display-box {
        border: 1px dashed #D2691E;
        background-color: rgba(210, 105, 30, 0.03);
        border-radius: 12px;
        padding: 16px;
    }
    .product-row {
        position: relative;
        padding: 16px 0;
        border-bottom: 1px solid #f1f1f4;
    }
    .product-row:last-child {
        border-bottom: none;
    }
    .flashsale-badge {
        background: linear-gradient(135deg, #ff4d4f, #f5222d);
        color: white;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 6px;
        display: inline-block;
    }
    .promo-box {
        border: 1px solid #e8e8e8;
        border-radius: 10px;
        padding: 12px;
        background-color: #fafafa;
    }
    .promo-option {
        cursor: pointer;
        padding: 8px;
        border-radius: 6px;
        transition: background 0.2s;
    }
    .promo-option:hover {
        background-color: #f0f0f0;
    }
    .quantity-control .btn {
        width: 28px;
        height: 28px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1px solid #d9d9d9;
        background: #fff;
        color: #555;
    }
    .quantity-control input {
        width: 35px;
        text-align: center;
        border: none;
        background: transparent;
        font-weight: 600;
    }
    .special-request-item {
        padding: 10px 0;
        border-bottom: 1px solid #f9f9f9;
    }
    .special-request-item:last-child {
        border-bottom: none;
    }
    /* Toggle Switch Custom */
    .form-switch .form-check-input {
        width: 2.5em;
        height: 1.25em;
        cursor: pointer;
    }
    .payment-method-card {
        border: 1px solid #e8e8e8;
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        transition: all 0.2s ease;
        background-color: #fff;
    }
    .payment-method-card:hover {
        border-color: #D2691E;
        background-color: rgba(210, 105, 30, 0.01);
    }
    .payment-method-card.selected {
        border-color: #D2691E;
        background-color: rgba(210, 105, 30, 0.03);
        box-shadow: 0 0 0 1px #D2691E;
    }
    .dashed-btn {
        border: 1px dashed #d9d9d9;
        background: transparent;
        border-radius: 8px;
        padding: 8px 16px;
        font-weight: 500;
        color: #555;
        transition: all 0.2s;
        width: 100%;
        text-align: center;
    }
    .dashed-btn:hover {
        border-color: #D2691E;
        color: #D2691E;
        background-color: rgba(210, 105, 30, 0.02);
    }
    /* Giao diện Modal */
    .delivery-tab-btn {
        border: 1px solid #d9d9d9;
        border-radius: 10px;
        padding: 12px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s;
        flex: 1;
    }
    .delivery-tab-btn.active {
        border-color: #D2691E;
        color: #D2691E;
        background-color: rgba(210, 105, 30, 0.04);
        font-weight: 600;
    }
    .login-cta-banner {
        background: linear-gradient(135deg, #fff7e6, #ffe7ba);
        border: 1px solid #ffd591;
        border-radius: 12px;
        padding: 12px 16px;
    }
</style>

<div class="container checkout-container">
    <form asp-action="Checkout" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        
        <!-- Các trường inputs ẩn để lưu trữ thông tin thực tế được submit lên server -->
        <input type="hidden" id="hiddenCustomerName" name="CustomerName" value="@Model.CustomerName" />
        <input type="hidden" id="hiddenPhone" name="Phone" value="@Model.Phone" />
        <input type="hidden" id="hiddenAddress" name="Address" value="@Model.Address" />
        <input type="hidden" id="hiddenNotes" name="Notes" value="@Model.Notes" />
        <input type="hidden" id="hiddenDeliveryMethod" name="DeliveryMethod" value="Giao tận nơi" />
        <input type="hidden" id="shippingFeeInput" name="ShippingFee" value="0" />
        <input type="hidden" id="shippingFeeOriginal" value="0" />
        <input type="hidden" id="hiddenPaymentMethod" name="PaymentMethod" value="COD" />
        <input type="hidden" id="hiddenUseMemberPoints" name="UseMemberPoints" value="false" />
        <input type="hidden" id="customerLat" value="" />
        <input type="hidden" id="customerLng" value="" />

        @for (int i = 0; i < Model.SelectedIds.Count; i++)
        {
            <input type="hidden" name="SelectedIds[@i]" value="@Model.SelectedIds[i]" />
        }

        <div class="row">
            <!-- CỘT TRÁI (60%): Chi tiết Đơn hàng & Tùy chọn -->
            <div class="col-lg-7 mb-4">
                <!-- 1. Tab Phương thức nhận hàng -->
                <div class="card card-custom p-3">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-truck me-2 text-primary"></i>1. Phương thức nhận hàng</h6>
                    <div class="top-tab d-flex">
                        <button type="button" class="nav-link active" id="tabGiaoTanNoiBtn" onclick="switchDeliveryTab('Giao tận nơi')">
                            <i class="bi bi-geo-alt-fill me-1"></i> Giao tận nơi
                        </button>
                        <button type="button" class="nav-link" id="tabNhanTaiSieuThiBtn" onclick="switchDeliveryTab('Ăn tại quán')">
                            <i class="bi bi-shop me-1"></i> Ăn tại quán
                        </button>
                    </div>
                </div>

                <!-- 3. Khối thông tin món ăn -->
                <div class="card card-custom p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-box-seam me-2 text-primary"></i>2. Thông tin phần ăn</h6>
                        <span class="flashsale-badge shadow-2xs">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i>
                            Khuyến mãi giờ vàng kết thúc sau: <span id="countdownTimer">13:45:51</span>
                        </span>
                    </div>

                    <div class="checkout-product-list">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="product-row d-flex flex-column gap-3" data-product-id="@item.ProductId" data-price="@item.Price">
                                <div class="d-flex align-items-start">
                                    <!-- Ảnh món ăn -->
                                    <img src="@item.ImageUrl" class="rounded-3 me-3 border" style="width: 75px; height: 75px; object-fit: cover;" alt="@item.Name" />
                                    
                                    <div class="flex-grow-1">
                                        <!-- Tên món ăn -->
                                        <h6 class="fw-bold text-dark mb-1" style="font-size: 0.95rem;">@item.Name</h6>
                                        <!-- Thuộc tính giả định -->
                                        <div class="text-secondary small mb-2"><i class="bi bi-palette me-1"></i>Ghi chú: Sợi mì Quảng</div>
                                        
                                        <!-- Giá món ăn -->
                                        <div class="d-flex align-items-baseline gap-2">
                                            <span class="fw-bold text-danger fs-5" id="priceDisplay-@item.ProductId">@item.Price.ToString("#,##0")đ</span>
                                            <span class="text-decoration-line-through text-muted small">@((item.Price * 1.15m).ToString("#,##0"))đ</span>
                                        </div>
                                    </div>

                                    <!-- Thao tác xóa & tăng giảm số lượng -->
                                    <div class="d-flex flex-column align-items-end justify-content-between h-100 ms-2">
                                        <button type="button" class="btn btn-link text-danger p-0 border-0 mb-3 text-decoration-none small fw-semibold" onclick="deleteProduct(@item.ProductId)">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                        
                                        <!-- Tăng giảm số lượng -->
                                        <div class="quantity-control d-flex align-items-center">
                                            <button type="button" class="btn" onclick="updateQty(@item.ProductId, -1)">-</button>
                                            <input type="text" id="qty-@item.ProductId" value="@item.Quantity" readonly />
                                            <button type="button" class="btn" onclick="updateQty(@item.ProductId, 1)">+</button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Chọn 1 trong 2 Khuyến mãi -->
                                <div class="promo-box">
                                    <div class="small fw-bold text-secondary mb-2"><i class="bi bi-gift-fill text-danger me-1"></i>Chọn 1 trong 2 khuyến mãi:</div>
                                    <div class="d-flex flex-column gap-1">
                                        <label class="promo-option d-flex align-items-center gap-2 mb-0">
                                            <input type="radio" name="Promo-@item.ProductId" class="form-check-input mt-0" checked onclick="calculateTotals()" />
                                            <span class="small text-dark">Tặng kèm bánh tráng nướng mè đen Đại Lộc giòn rụm</span>
                                        </label>
                                        <label class="promo-option d-flex align-items-center gap-2 mb-0">
                                            <input type="radio" name="Promo-@item.ProductId" class="form-check-input mt-0" onclick="calculateTotals()" />
                                            <span class="small text-dark">Tặng phiếu giảm giá 10% cho đơn hàng sau</span>
                                        </label>
                                    </div>
                                    <div class="text-primary mt-2 small cursor-pointer fw-semibold text-end" style="font-size: 0.8rem;">
                                        Xem thêm ưu đãi khác <i class="bi bi-chevron-down ms-1"></i>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- 5. Yêu cầu đặc biệt -->
                <div class="card card-custom p-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-pencil-square me-2 text-primary"></i>3. Yêu cầu đặc biệt</h6>
                    <div class="d-flex flex-column gap-2">
                        <div class="special-request-item d-flex align-items-center justify-content-between">
                            <label class="form-check-label text-dark fw-medium" for="reqNoSpicy">
                                <i class="bi bi-fire text-muted me-2"></i> Ít cay / Không cay (không bỏ ớt)
                            </label>
                            <input class="form-check-input" type="checkbox" id="reqNoSpicy" onchange="updateNotesField()" />
                        </div>
                        <div class="special-request-item d-flex align-items-center justify-content-between">
                            <label class="form-check-label text-dark fw-medium" for="reqMoreSoup">
                                <i class="bi bi-droplet-half text-muted me-2"></i> Lấy thêm nước lèo riêng
                            </label>
                            <input class="form-check-input" type="checkbox" id="reqMoreSoup" onchange="updateNotesField()" />
                        </div>
                        <div class="special-request-item d-flex align-items-center justify-content-between">
                            <label class="form-check-label text-dark fw-medium" for="reqUtensils">
                                <i class="bi bi-egg-fried text-muted me-2"></i> Yêu cầu thêm muỗng đũa ăn kèm
                            </label>
                            <input class="form-check-input" type="checkbox" id="reqUtensils" onchange="updateNotesField()" />
                        </div>
                    </div>
                </div>

                <!-- 8. Hình thức thanh toán -->
                <div class="card card-custom p-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-credit-card-2-front me-2 text-primary"></i>4. Hình thức thanh toán</h6>
                    <div class="d-flex flex-column gap-3">
                        <!-- Option 1: Ví điện tử -->
                        <div class="payment-method-card d-flex align-items-start gap-3" id="payEWallet" onclick="selectPaymentMethod('EWallet')">
                            <input class="form-check-input mt-1" type="radio" name="PaymentMethodOption" id="radioEWallet" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                    Qua ví MoMo / ZaloPay
                                    <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">Ưu đãi giảm 5%</span>
                                </div>
                                <div class="text-secondary small mt-1">Thanh toán bằng ví điện tử nhanh chóng, tiện lợi.</div>
                            </div>
                        </div>

                        <!-- Option 2: Chuyển khoản ngân hàng -->
                        <div class="payment-method-card d-flex align-items-start gap-3" id="payBank" onclick="selectPaymentMethod('Bank')">
                            <input class="form-check-input mt-1" type="radio" name="PaymentMethodOption" id="radioBank" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark">Chuyển khoản ngân hàng (Thủ công)</div>
                                <div class="text-secondary small mt-1">Thông tin tài khoản ngân hàng sẽ được hiển thị khi đặt hàng thành công.</div>
                            </div>
                        </div>

                        <!-- Option 2.5: Chuyển khoản VietQR -->
                        <div class="payment-method-card d-flex align-items-start gap-3" id="payVietQR" onclick="selectPaymentMethod('VietQR')">
                            <input class="form-check-input mt-1" type="radio" name="PaymentMethodOption" id="radioVietQR" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                    Thanh toán qua VietQR (Chuyển khoản nhanh)
                                    <span class="badge bg-success text-white" style="font-size: 0.65rem;">Khuyên dùng</span>
                                </div>
                                <div class="text-secondary small mt-1">Quét mã QR động chuyển khoản bằng mọi ứng dụng ngân hàng tức thì, chính xác.</div>
                            </div>
                        </div>

                        <!-- Option 3: COD -->
                        <div class="payment-method-card d-flex align-items-start gap-3 selected" id="payCOD" onclick="selectPaymentMethod('COD')">
                            <input class="form-check-input mt-1" type="radio" name="PaymentMethodOption" id="radioCOD" checked />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark">Thanh toán tiền mặt khi giao hàng (COD)</div>
                                <div class="text-secondary small mt-1">Nhận món ăn nóng hổi rồi mới trả tiền trực tiếp cho tài xế giao hàng.</div>
                            </div>
                        </div>
                    </div>
                    <div class="text-primary mt-3 small cursor-pointer fw-semibold text-end">
                        Xem thêm hình thức thanh toán khác <i class="bi bi-chevron-down ms-1"></i>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI (40%): Tổng kết & Nút đặt hàng -->
            <div class="col-lg-5">
                <div class="position-sticky" style="top: 100px;">
                    <!-- 2. Khối Địa chỉ giao hàng (Tóm tắt ở cột phải) -->
                    <div class="card card-custom p-4">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-geo-alt text-primary me-2"></i>Địa chỉ nhận hàng</h6>
                        <div class="address-display-box">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-bold text-dark" id="displayRecipientName">Chưa cung cấp tên nhận hàng</div>
                                    <div class="text-secondary small py-1" id="displayRecipientPhone">Chưa cung cấp SĐT</div>
                                    <div class="text-dark small" id="displayDeliveryType"><span class="badge bg-secondary">Giao tận nơi</span></div>
                                    <div class="text-dark fw-semibold mt-1" id="displayAddress">Thành phố Hồ Chí Minh</div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#deliveryModal">
                                    <i class="bi bi-pencil-square me-1"></i> Cung cấp / Sửa địa chỉ giao hàng
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- 4, 6, 7. Khối tính tiền chi tiết -->
                    <div class="card card-custom p-4">
                        <!-- Tạm tính -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-secondary" id="subtotalLabel">Tạm tính (0 phần ăn):</span>
                            <span class="fw-bold text-dark fs-5" id="subtotalPrice">0đ</span>
                        </div>

                        <!-- Phí vận chuyển -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-secondary">Phí vận chuyển:</span>
                            <span class="fw-bold text-dark fs-5" id="shippingFeePrice">Chưa chọn tỉnh/thành</span>
                        </div>

                        <!-- Điểm thành viên và Toggle -->
                        <div class="d-flex align-items-center justify-content-between py-3 my-2 border-top border-bottom">
                            <div>
                                <div class="fw-bold text-dark small">Dùng điểm thành viên Mì 3AE</div>
                                <div class="text-secondary" style="font-size: 0.75rem;">Đang có sẵn: <strong class="text-warning">22.190 điểm</strong></div>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="toggleMemberPoints" onchange="calculateTotals()" />
                            </div>
                        </div>

                        <!-- Mã giảm giá -->
                        <div class="d-flex justify-content-between align-items-center py-2 mb-3 bg-light rounded-3 px-3 cursor-pointer" style="border: 1px solid #e8e8e8;">
                            <span class="small fw-semibold text-secondary"><i class="bi bi-ticket-perforated-fill text-danger me-2"></i>Chọn hoặc nhập mã giảm</span>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </div>

                        <!-- Tổng tiền -->
                        <div class="d-flex justify-content-between align-items-center pt-2 mb-2">
                            <span class="fw-bold text-dark fs-5">Tổng tiền:</span>
                            <span class="fw-bold text-primary fs-3" id="totalPrice">0đ</span>
                        </div>

                        <!-- Điểm tích lũy cho đơn này -->
                        <div class="d-flex justify-content-between align-items-center text-secondary small mb-4">
                            <span>Điểm tích lũy thành viên Mì 3AE:</span>
                            <span class="fw-bold text-warning" id="earnedPoints">0 điểm</span>
                        </div>

                        <!-- Nút Đặt hàng -->
                        <button type="submit" class="btn btn-warning w-100 rounded-pill py-3 fw-bold text-white shadow" style="background: linear-gradient(135deg, #ff7a00, #ff5500); border: none;" onclick="return validateCheckoutForm()">
                            ĐẶT HÀNG NGAY
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- ========================================== -->
<!-- MODAL THÔNG TIN GIAO HÀNG (DELIVERY MODAL) -->
<!-- ========================================== -->
<div class="modal fade" id="deliveryModal" tabindex="-1" aria-labelledby="deliveryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <!-- 1. Tiêu đề Modal -->
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="deliveryModalLabel">
                    <i class="bi bi-truck text-primary me-2"></i> Thông tin giao hàng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body pt-3">
                <!-- 2. Khối Thông tin người đặt -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary small">Thông tin người đặt</label>
                    
                    <!-- Danh xưng -->
                    <div class="d-flex gap-4 mb-3">
                        <label class="form-check-label d-flex align-items-center gap-2 cursor-pointer">
                            <input type="radio" name="modalGender" class="form-check-input mt-0" id="genderMale" checked />
                            <span>Anh</span>
                        </label>
                        <label class="form-check-label d-flex align-items-center gap-2 cursor-pointer">
                            <input type="radio" name="modalGender" class="form-check-input mt-0" id="genderFemale" />
                            <span>Chị</span>
                        </label>
                    </div>

                    <!-- Trường nhập Họ Tên & SĐT -->
                    <div class="mb-3">
                        <input type="text" class="form-control rounded-3 border-light-subtle px-3 py-2 bg-light bg-opacity-50" id="modalCustomerName" placeholder="Họ và Tên" value="@Model.CustomerName" />
                        <div class="text-danger small mt-1 d-none" id="errorModalName">Họ tên không được để trống.</div>
                    </div>
                    <div class="mb-3">
                        <input type="text" class="form-control rounded-3 border-light-subtle px-3 py-2 bg-light bg-opacity-50" id="modalPhone" placeholder="Số điện thoại" value="@Model.Phone" />
                        <div class="text-danger small mt-1 d-none" id="errorModalPhone">Số điện thoại không hợp lệ (cần từ 10 số).</div>
                    </div>

                    <!-- Khối gợi ý đăng nhập (Chỉ hiển thị nếu chưa đăng nhập) -->
                    @if (!SignInManager.IsSignedIn(User))
                    {
                        <div class="login-cta-banner d-flex align-items-center justify-content-between shadow-2xs">
                            <div class="small text-dark-emphasis fw-medium me-2" style="font-size: 0.85rem;">
                                Đăng nhập để tự động điền thông tin giao hàng trong 10s
                            </div>
                            <a class="btn btn-warning btn-sm rounded-pill fw-bold text-white px-3" asp-controller="Account" asp-action="Login" style="background-color: #ff7a00; border: none; font-size: 0.75rem;">
                                Đăng nhập
                            </a>
                        </div>
                    }
                </div>

                <!-- 3. Khối Chọn hình thức nhận hàng -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary small mb-2">Chọn hình thức nhận hàng</label>
                    <div class="d-flex gap-3 mb-3">
                        <div class="delivery-tab-btn active" id="modalGiaoTanNoiBtn" onclick="modalSwitchDelivery('Giao tận nơi')">
                            <i class="bi bi-truck-flatbed fs-4 d-block mb-1"></i> Giao tận nơi
                        </div>
                        <div class="delivery-tab-btn" id="modalNhanTaiSieuThiBtn" onclick="modalSwitchDelivery('Ăn tại quán')">
                            <i class="bi bi-shop fs-4 d-block mb-1"></i> Ăn tại quán
                        </div>
                    </div>

                    <!-- ====== KHỐI GIAO TẬN NƠI (hiện mặc định) ====== -->
                    <div id="deliveryFieldsContainer">
                        <!-- Nút định vị GPS -->
                        <div class="mb-3">
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill w-100 fw-bold py-2" id="btnGpsLocator" onclick="getCurrentGpsLocation()">
                                <i class="bi bi-geo-alt-fill me-1"></i> Định vị vị trí hiện tại (GPS)
                            </button>
                            <div id="gpsStatus" class="small text-muted mt-1 text-center d-none"></div>
                        </div>

                        <!-- Địa chỉ đang chọn -->
                        <div class="p-3 bg-light rounded-3 mb-3 border border-light-subtle">
                            <div class="text-secondary small mb-1">Địa chỉ giao hàng hiện tại:</div>
                            <div class="fw-semibold text-dark" id="modalDisplayAddress">Thành phố Hồ Chí Minh</div>
                        </div>

                        <!-- Tìm kiếm địa chỉ thủ công (Forward Geocoding) -->
                        <div class="mb-3">
                            <label for="addressSearchInput" class="form-label fw-bold text-secondary small">Hoặc tìm kiếm địa chỉ giao hàng</label>
                            <div class="input-group">
                                <input type="text" class="form-control border-light-subtle bg-light bg-opacity-50" id="addressSearchInput" placeholder="Nhập địa chỉ (VD: 1 Võ Văn Ngân, Thủ Đức)" onkeypress="if(event.key === 'Enter') { searchAddress(); return false; }">
                                <button class="btn btn-primary fw-bold px-3" type="button" onclick="searchAddress()" id="btnSearchAddress">
                                    <i class="bi bi-search"></i> Tìm
                                </button>
                            </div>
                            <div id="searchAddressStatus" class="small text-muted mt-1 d-none"></div>
                        </div>

                        <!-- Nút chỉnh sửa địa chỉ chi tiết -->
                        <div class="mb-3">
                            <button type="button" class="dashed-btn" onclick="toggleEditAddressField()">
                                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa thông tin địa chỉ giao hàng
                            </button>
                        </div>

                        <!-- Trường nhập chi tiết địa chỉ (mặc định ẩn, hiện ra khi bấm nút chỉnh sửa) -->
                        <div id="addressEditContainer" class="d-none mb-3">
                            <textarea class="form-control rounded-3 border-light-subtle px-3 py-2 bg-light bg-opacity-50" id="modalAddressDetail" rows="2" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                        </div>

                        <!-- Tùy chọn đặt hàng cho người khác -->
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="modalOtherReceiver" onchange="toggleOtherReceiverForm()" />
                            <label class="form-check-label text-dark small fw-semibold" for="modalOtherReceiver">
                                <i class="bi bi-gift me-1 text-danger"></i> Đặt hàng cho người khác (Mua tặng)
                            </label>
                        </div>

                        <!-- Khối thông tin người nhận khác (mặc định ẩn) -->
                        <div id="otherReceiverContainer" class="d-none mb-3">
                            <div class="p-3 rounded-3 border" style="border-color: #ffd591 !important; background: linear-gradient(135deg, #fffbe6, #fff7e6);">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="bi bi-info-circle-fill text-warning"></i>
                                    <span class="small fw-bold text-dark">Thông tin người nhận hàng</span>
                                </div>
                                <div class="small text-muted mb-3" style="font-size: 0.78rem;">
                                    <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                                    Vui lòng điền <strong>chính xác</strong> họ tên và số điện thoại của người nhận để tài xế có thể liên hệ giao hàng đúng người.
                                </div>
                                <div class="mb-2">
                                    <input type="text" class="form-control form-control-sm rounded-3 border-light-subtle px-3 py-2 bg-white" id="otherReceiverName" placeholder="Họ và tên người nhận hàng *" />
                                    <div class="text-danger small mt-1 d-none" id="errorOtherName">Vui lòng nhập họ tên người nhận.</div>
                                </div>
                                <div class="mb-2">
                                    <input type="text" class="form-control form-control-sm rounded-3 border-light-subtle px-3 py-2 bg-white" id="otherReceiverPhone" placeholder="Số điện thoại người nhận *" />
                                    <div class="text-danger small mt-1 d-none" id="errorOtherPhone">Số điện thoại người nhận không hợp lệ.</div>
                                </div>
                                <div>
                                    <textarea class="form-control form-control-sm rounded-3 border-light-subtle px-3 py-2 bg-white" id="otherReceiverNote" rows="2" placeholder="Lời nhắn gửi kèm (Ví dụ: 'Chúc sinh nhật vui vẻ!')"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ====== KHỐI ĂN TẠI QUÁN (mặc định ẩn) ====== -->
                    <div id="dineInFieldsContainer" class="d-none">
                        <div class="p-3 rounded-3 border mb-3" style="border-color: #b7eb8f !important; background: linear-gradient(135deg, #f6ffed, #fcffe6);">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-shop fs-5 text-success"></i>
                                <span class="fw-bold text-dark">Thông tin ăn tại quán Mì 3AE</span>
                            </div>

                            <div class="small text-muted mb-3" style="font-size: 0.8rem;">
                                <i class="bi bi-info-circle text-primary me-1"></i>
                                Quán sẽ chuẩn bị trước phần ăn dựa trên thời gian bạn dự kiến đến. Vui lòng điền chính xác để quán phục vụ tốt nhất!
                            </div>

                            <!-- Số lượng khách -->
                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary small mb-1">Số lượng khách đến ăn</label>
                                <select class="form-select form-select-sm rounded-3 border-light-subtle px-3 py-2 bg-white" id="dineInGuestCount">
                                    <option value="1">1 người</option>
                                    <option value="2" selected>2 người</option>
                                    <option value="3">3 người</option>
                                    <option value="4">4 người</option>
                                    <option value="5">5 người</option>
                                    <option value="6">6 người</option>
                                    <option value="7">7 - 10 người</option>
                                    <option value="10">Trên 10 người (Liên hệ quán trước)</option>
                                </select>
                            </div>

                            <!-- Ngày dự kiến đến -->
                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary small mb-1">Ngày dự kiến đến quán</label>
                                <input type="date" class="form-control form-control-sm rounded-3 border-light-subtle px-3 py-2 bg-white" id="dineInDate" />
                                <div class="text-danger small mt-1 d-none" id="errorDineInDate">Vui lòng chọn ngày đến quán.</div>
                            </div>

                            <!-- Giờ dự kiến đến -->
                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary small mb-1">Giờ dự kiến đến quán</label>
                                <select class="form-select form-select-sm rounded-3 border-light-subtle px-3 py-2 bg-white" id="dineInTime">
                                    <option value="">-- Chọn giờ --</option>
                                    <option value="07:00">07:00 - Sáng sớm</option>
                                    <option value="08:00">08:00 - Sáng</option>
                                    <option value="09:00">09:00 - Sáng</option>
                                    <option value="10:00">10:00 - Gần trưa</option>
                                    <option value="11:00" selected>11:00 - Trưa</option>
                                    <option value="12:00">12:00 - Trưa</option>
                                    <option value="13:00">13:00 - Chiều</option>
                                    <option value="14:00">14:00 - Chiều</option>
                                    <option value="15:00">15:00 - Xế chiều</option>
                                    <option value="16:00">16:00 - Xế chiều</option>
                                    <option value="17:00">17:00 - Chiều tối</option>
                                    <option value="18:00">18:00 - Tối</option>
                                    <option value="19:00">19:00 - Tối</option>
                                    <option value="20:00">20:00 - Tối muộn</option>
                                    <option value="21:00">21:00 - Đóng cửa lúc 21:30</option>
