@model GIUA_KY_WEB_3AE.Models.Order

@{
    ViewData["Title"] = "Đặt món thành công";
    
    // Kiểm tra đơn hàng đã thanh toán qua VietQR hay chưa (dựa trên ghi chú đơn hàng)
    var isPaidVietQR = Model.Notes != null && Model.Notes.Contains("Đã thanh toán qua VietQR");
}

<div class="container my-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                <div class="success-icon mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                </div>
                <h1 class="fw-bold text-dark mb-3">Đặt Món Thành Công!</h1>
                <p class="text-secondary fs-5 mb-4">Cảm ơn bạn đã đặt món tại Mì 3AE. Đơn đặt món của bạn đã được tiếp nhận thành công.</p>
                
                <div class="bg-light rounded-4 p-4 mb-4 text-start">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Mã đơn hàng:</span>
                        <span class="fw-bold text-dark">#@Model.Id</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Người nhận:</span>
                        <span class="fw-bold text-dark">@Model.CustomerName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Số điện thoại:</span>
                        <span class="fw-bold text-dark">@Model.Phone</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Tổng tiền:</span>
                        <span class="fw-bold text-primary">@Model.TotalAmount.ToString("#,##0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-secondary">Trạng thái:</span>
                        @if (isPaidVietQR)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1 small fw-bold">
                                <i class="bi bi-shield-fill-check me-1"></i>Đã thanh toán qua VietQR
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1 small fw-bold">Chờ xử lý</span>
                        }
                    </div>
                </div>

                @if (isPaidVietQR)
                {
                    <!-- Thông báo xác nhận đã thanh toán thành công -->
                    <div class="alert alert-success border-0 rounded-4 d-flex align-items-center gap-3 text-start mb-4 shadow-sm" role="alert">
                        <i class="bi bi-patch-check-fill text-success fs-3"></i>
                        <div>
                            <div class="fw-bold text-dark">Thanh toán đã được xác nhận</div>
                            <div class="text-muted small">Bạn đã thanh toán thành công qua VietQR. Đơn hàng sẽ được xử lý và giao đến bạn trong thời gian sớm nhất.</div>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-mi-primary rounded-pill px-4 py-2.5 text-white fw-bold shadow-sm hover-btn">
                        Quay lại Thực đơn
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-btn {
        transition: all 0.3s ease;
    }
    .btn-mi-primary {
        background-color: #D2691E;
        border-color: #D2691E;
    }
    .btn-mi-primary:hover {
        background-color: #b85b1a;
        border-color: #b85b1a;
    }
    .hover-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(210, 105, 30, 0.4) !important;
    }
</style>
