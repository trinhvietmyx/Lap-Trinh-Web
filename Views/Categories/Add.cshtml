@model GIUA_KY_WEB_3AE.Models.Category

@{
    ViewData["Title"] = "Thêm danh mục mới";
}

<div class="container my-5" style="max-width: 600px;">
    <!-- Nút quay lại -->
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-secondary d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Card Form -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-5">
        <div class="border-bottom pb-3 mb-4">
            <h1 class="h3 fw-bold text-dark mb-1">Thêm danh mục mới</h1>
            <p class="text-muted mb-0">Tạo danh mục sản phẩm mới trong hệ thống</p>
        </div>

        <form asp-action="Add" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-semibold text-dark">Tên danh mục</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-3 text-secondary">
                        <i class="bi bi-tag"></i>
                    </span>
                    <input asp-for="Name" class="form-control border-start-0 rounded-end-3 py-2" placeholder="Ví dụ: Điện gia dụng, Thiết bị văn phòng..." />
                </div>
                <span asp-validation-for="Name" class="text-danger fs-7 mt-1 d-block"></span>
            </div>

            <!-- Nút gửi form -->
            <div class="d-flex justify-content-end gap-3 border-top pt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Thêm mới
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .fs-7 {
        font-size: 0.85rem;
    }
</style>
