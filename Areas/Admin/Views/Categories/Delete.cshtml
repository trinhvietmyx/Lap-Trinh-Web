@model GIUA_KY_WEB_3AE.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục - Admin";
}

<div class="container my-5" style="max-width: 600px;">
    <!-- Nút quay lại -->
    <div class="mb-4">
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="text-decoration-none text-secondary d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i> Quay lại danh sách danh mục
        </a>
    </div>

    <!-- Hộp xác nhận xóa -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white p-5">
        <div class="text-center mb-4">
            <div class="display-4 text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h1 class="h3 fw-bold text-dark mb-1">Xác nhận xóa danh mục?</h1>
            <p class="text-muted mb-0">Hành động này sẽ xóa danh mục và có thể ảnh hưởng tới các món ăn thuộc danh mục này. Bạn có chắc chắn muốn xóa?</p>
        </div>

        <div class="border rounded-3 p-3 bg-light mb-4 text-center">
            <h5 class="fw-bold text-dark mb-1">Danh mục: @Model.Name</h5>
            <small class="text-muted">Mã danh mục: #@Model.Id</small>
        </div>

        <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-danger btn-lg rounded-pill shadow-sm py-2 text-white">
                    <i class="bi bi-trash3-fill me-1"></i> Có, Xóa Danh Mục
                </button>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill py-2">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>
