@model IEnumerable<GIUA_KY_WEB_3AE.Models.Category>

@{
    ViewData["Title"] = "Quản lý danh mục - Mì 3AE Admin";
}

<div class="container my-5" style="max-width: 800px;">
    <!-- Thông báo kết quả thao tác -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4 p-3 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="display-6 fw-bold text-dark mb-1"><i class="bi bi-tags-fill text-primary"></i> Quản Lý Danh Mục</h1>
            <p class="text-muted mb-0">Hệ thống phân loại món ăn trong thực đơn Mì 3AE</p>
        </div>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Add" class="btn btn-primary shadow-sm rounded-pill px-4 py-2 text-white">
            <i class="bi bi-plus-circle-fill me-2"></i> Thêm danh mục mới
        </a>
    </div>

    <!-- Bảng danh mục -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary uppercase fs-7 fw-semibold border-bottom">
                        <tr>
                            <th scope="col" class="ps-4 py-3" style="width: 100px;">Mã số</th>
                            <th scope="col" class="py-3">Tên danh mục món ăn</th>
                            <th scope="col" class="py-3 text-center" style="width: 220px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="bi bi-tag-fill display-4 mb-3 d-block text-secondary"></i>
                                    Chưa có danh mục nào. Hãy thêm danh mục đầu tiên!
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-semibold text-secondary">
                                        #@item.Id
                                    </td>
                                    <td class="py-3 fw-bold text-dark">
                                        @item.Name
                                    </td>
                                    <td class="py-3 text-center pe-4">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-area="Admin" asp-controller="Categories" asp-action="Update" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .fs-7 {
        font-size: 0.85rem;
    }
</style>
