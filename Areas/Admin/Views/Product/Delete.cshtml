@model GIUA_KY_WEB_3AE.Models.Product

@{
    ViewData["Title"] = "Xóa món ăn - " + Model.Name;
}

<div class="container my-5" style="max-width: 650px;">
    <!-- Nút quay lại -->
    <div class="mb-4">
        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="text-decoration-none text-secondary d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i> Quay lại danh sách quản lý
        </a>
    </div>

    <!-- Hộp xác nhận xóa -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white p-5">
        <div class="text-center mb-4">
            <div class="display-4 text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h1 class="h3 fw-bold text-dark mb-1">Xác nhận xóa món ăn?</h1>
            <p class="text-muted mb-0">Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa món ăn này khỏi thực đơn?</p>
        </div>

        <div class="border rounded-3 p-3 bg-light mb-4">
            <div class="d-flex align-items-center gap-3">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded border" style="width: 80px; height: 80px; object-fit: cover;" />
                <div>
                    <h5 class="fw-bold text-dark mb-1">@Model.Name</h5>
                    <p class="text-primary fw-bold mb-0">@Model.Price.ToString("#,##0") đ</p>
                    <small class="text-muted">Danh mục: @ViewBag.CategoryName</small>
                </div>
            </div>
        </div>

        <form asp-area="Admin" asp-controller="Product" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-danger btn-lg rounded-pill shadow-sm py-2">
                    <i class="bi bi-trash3-fill me-1"></i> Có, Xóa Món Ăn
                </button>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill py-2">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>
