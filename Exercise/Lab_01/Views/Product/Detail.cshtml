@model Lab_01.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-shell" style="padding-top: 40px; padding-bottom: 80px;">
    <nav style="margin-bottom: 30px; font-family: Arial, sans-serif; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em;">
        <a href="/Product/Category" style="color: #777;">Sản phẩm</a> / <span style="color: #111; font-weight: bold;">@Model.Name</span>
    </nav>

    <div class="product-detail-container" style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 60px;">
        <!-- Ảnh sản phẩm -->
        <div class="product-gallery">
            <div class="product-photo" style="aspect-ratio: 0.8; width: 100%;">
                <img src="@Model.Image" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                @if (!string.IsNullOrEmpty(Model.Sale))
                {
                    <span class="sale-badge" style="background: #111;">@Model.Sale</span>
                }
            </div>
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="product-info">
            <p style="font-family: Arial, sans-serif; font-size: 0.8rem; color: #777; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px;">New Arrival</p>
            <h1 style="font-size: 2.8rem; margin: 0 0 20px; line-height: 1.1;">@Model.Name</h1>
            
            <div class="price-row" style="margin-bottom: 30px;">
                <span class="price" style="font-size: 1.5rem;">@Model.Price</span>
                @if (!string.IsNullOrEmpty(Model.OldPrice))
                {
                    <span class="old-price" style="font-size: 1.1rem; margin-left: 15px;">@Model.OldPrice</span>
                }
            </div>

            <div style="border-top: 1px solid #eee; border-bottom: 1px solid #eee; padding: 25px 0; margin-bottom: 35px;">
                <p style="line-height: 1.8; color: #444; margin: 0;">
                    @Model.Description
                </p>
            </div>

            <div class="actions" style="display: grid; gap: 15px;">
                <button style="background: #111; color: #fff; border: none; padding: 18px; font-family: Arial, sans-serif; font-weight: bold; text-transform: uppercase; cursor: pointer; letter-spacing: 0.1em;">
                    Thêm vào giỏ hàng
                </button>
                <button style="background: #fff; color: #111; border: 1px solid #111; padding: 18px; font-family: Arial, sans-serif; font-weight: bold; text-transform: uppercase; cursor: pointer; letter-spacing: 0.1em;">
                    Mua ngay
                </button>
            </div>

            <div style="margin-top: 40px; font-family: Arial, sans-serif; font-size: 0.85rem; color: #666;">
                <p>• Giao hàng miễn phí toàn quốc cho đơn hàng trên 1.000.000đ</p>
                <p>• Đổi trả trong vòng 7 ngày nếu có lỗi từ nhà sản xuất</p>
            </div>
        </div>
    </div>
</div>

<style>
    @@media (max-width: 768px) {
        .product-detail-container {
            grid-template-columns: 1fr;
            gap: 30px;
        }
    }
</style>
