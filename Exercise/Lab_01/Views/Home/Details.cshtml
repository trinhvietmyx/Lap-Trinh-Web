@model Lab_01.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="product-details-page page-shell">
    <nav class="breadcrumb-nav">
        <a asp-action="Index">Trang chủ</a> / <span>@Model.Name</span>
    </nav>

    <div class="details-container">
        <div class="details-image">
            <img src="@Model.Image" alt="@Model.Name" />
            @if (!string.IsNullOrEmpty(Model.Sale))
            {
                <span class="details-sale-badge">@Model.Sale</span>
            }
        </div>

        <div class="details-info">
            <h1 class="product-title">@Model.Name</h1>
            
            <div class="details-price-row">
                <span class="details-price">@Model.Price</span>
                @if (!string.IsNullOrEmpty(Model.OldPrice))
                {
                    <span class="details-old-price">@Model.OldPrice</span>
                }
            </div>

            <p class="product-description">
                @Model.Description
            </p>

            <div class="purchase-actions">
                <div class="quantity-selector">
                    <button type="button" onclick="this.nextElementSibling.stepDown()">-</button>
                    <input type="number" value="1" min="1" max="99" />
                    <button type="button" onclick="this.previousElementSibling.stepUp()">+</button>
                </div>
                <button class="add-to-cart-btn">Thêm vào giỏ hàng</button>
            </div>

            <div class="product-meta">
                <p><strong>Danh mục:</strong> Thời trang hè, StyleHub Select</p>
                <p><strong>Mã sản phẩm:</strong> SH-@Model.Id.ToString("D4")</p>
            </div>
        </div>
    </div>
</div>

<style>
    .product-details-page {
        padding-top: 2rem;
        padding-bottom: 4rem;
    }

    .breadcrumb-nav {
        margin-bottom: 2rem;
        font-size: 0.9rem;
        color: #777;
    }

    .breadcrumb-nav a {
        color: #222;
        text-decoration: none;
        font-weight: 700;
    }

    .details-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: start;
    }

    .details-image {
        position: relative;
        background: #f7f7f7;
    }

    .details-image img {
        width: 100%;
        height: auto;
        display: block;
    }

    .details-sale-badge {
        position: absolute;
        top: 0;
        left: 0;
        background: #fff173;
        color: #111;
        padding: 0.5rem 1rem;
        font-weight: 700;
        font-size: 1rem;
    }

    .product-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        line-height: 1.1;
    }

    .details-price-row {
        margin-bottom: 2rem;
        display: flex;
        align-items: baseline;
        gap: 1rem;
    }

    .details-price {
        font-size: 1.5rem;
        font-weight: 700;
        color: #e64040;
    }

    .details-old-price {
        font-size: 1.1rem;
        color: #999;
        text-decoration: line-through;
    }

    .product-description {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #444;
        margin-bottom: 2.5rem;
    }

    .purchase-actions {
        display: flex;
        gap: 1rem;
        margin-bottom: 3rem;
    }

    .quantity-selector {
        display: flex;
        border: 1px solid #ddd;
    }

    .quantity-selector button {
        background: none;
        border: none;
        width: 40px;
        height: 48px;
        font-size: 1.2rem;
        cursor: pointer;
    }

    .quantity-selector input {
        width: 50px;
        border: none;
        text-align: center;
        font-weight: 700;
        font-size: 1rem;
        -moz-appearance: textfield;
    }

    .quantity-selector input::-webkit-outer-spin-button,
    .quantity-selector input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .add-to-cart-btn {
        flex-grow: 1;
        background: #111;
        color: #fff;
        border: none;
        padding: 0 2rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: background 0.3s;
    }

    .add-to-cart-btn:hover {
        background: #333;
    }

    .product-meta {
        border-top: 1px solid #eee;
        padding-top: 1.5rem;
        font-size: 0.9rem;
        color: #666;
    }

    .product-meta p {
        margin-bottom: 0.5rem;
    }

    @@media (max-width: 768px) {
        .details-container {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .product-title {
            font-size: 2rem;
        }
    }
</style>
